                  "contentUrl": "https://open.spotify.com/episode/5M1iN9iKD3qCgWxKxD2VUz"
                }
              }
            },
            {
              "@type": "ListItem",
              "position": 5,
              "item": {
                "@type": "PodcastEpisode",
                "@id": "https://www.mikeye.com/podcast/the-question-beneath-the-question#episode",
                "name": "The Question Beneath the Question",
                "url": "https://www.mikeye.com/podcast/the-question-beneath-the-question",
                "description": "Episode 2 of The Mike Ye Briefing explores the deeper questions beneath a founder's request for valuation. Through a recipe site losing traffic to AI search, a laundromat owner preparing to retire, and the decisions that shaped Rolling Stone, the episode examines readiness, identity, regret, and what happens after an exit.",
                "episodeNumber": 2,
                "datePublished": "2026-08-15",
