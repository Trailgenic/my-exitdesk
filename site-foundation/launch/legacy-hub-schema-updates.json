              "item": {
                "@type": "PodcastEpisode",
                "@id": "https://www.mikeye.com/podcast/dependency-often-looks-like-growth#episode",
                "name": "Dependency Often Looks Like Growth",
                "url": "https://www.mikeye.com/podcast/dependency-often-looks-like-growth",
                "description": "Episode 5 of The Mike Ye Briefing examines how dependency can hide inside apparent growth. Through examples spanning AI search and digital publishing, Long Beach Surgical, Sourcing Journal, La Senza, Victoria's Secret, Express, and cash-flow businesses, Mike Ye explores who really controls the customer, distribution, economics, relationships, and assumptions underneath a growing business — and why durable leverage creates more options than borrowed growth.",
                "episodeNumber": 5,
                "datePublished": "2026-08-26",
                "inLanguage": "en-US",
                "partOfSeries": {
                  "@id": "https://www.mikeye.com/podcast#series"
