            {
              "@type": "ListItem",
              "position": 6,
              "item": {
                "@type": "PodcastEpisode",
                "@id": "https://www.mikeye.com/podcast/before-consequence-arrives#episode",
                "name": "Before Consequence Arrives",
                "url": "https://www.mikeye.com/podcast/before-consequence-arrives",
                "description": "Episode 1 of The Mike Ye Briefing introduces the idea that preparation does not start when consequence arrives. It starts earlier — before the buyer appears, before the market changes, before the doctor gives the warning, and before someone else defines your options for you.",
