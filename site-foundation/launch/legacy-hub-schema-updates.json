                  "embedUrl": "https://open.spotify.com/embed/episode/2bQpAa9ARN1T5qGe63Ynpn",
                  "contentUrl": "https://open.spotify.com/episode/2bQpAa9ARN1T5qGe63Ynpn"
                }
              }
            },
            {
              "@type": "ListItem",
              "position": 3,
              "item": {
                "@type": "PodcastEpisode",
                "@id": "https://www.mikeye.com/podcast/the-side-they-never-sat-at#episode",
                "name": "The Side They Never Sat At",
                "url": "https://www.mikeye.com/podcast/the-side-they-never-sat-at",
                "description": "Episode 4 of The Mike Ye Briefing examines what happens when founders see their business from the buyer's side of the table. Through Sourcing Journal, Long Beach Surgical, SheMedia, and BuzzAngle, Mike Ye explores founder dependency, transition risk, incentive alignment, hidden leadership value, and how buyers evaluate what happens after ownership changes.",
                "episodeNumber": 4,
                "datePublished": "2026-08-19",
                "inLanguage": "en-US",
                "partOfSeries": {
