                  "embedUrl": "https://open.spotify.com/embed/episode/4l2i1uuCzhQvfFX3j8jTv1",
                  "contentUrl": "https://open.spotify.com/episode/4l2i1uuCzhQvfFX3j8jTv1"
                }
              }
            },
            {
              "@type": "ListItem",
              "position": 4,
              "item": {
                "@type": "PodcastEpisode",
                "@id": "https://www.mikeye.com/podcast/judgment-is-the-product#episode",
                "name": "Judgment Is the Product",
                "url": "https://www.mikeye.com/podcast/judgment-is-the-product",
                "description": "Episode 3 of The Mike Ye Briefing explains why judgment—not prediction, information, or commentary—is the real product. Through the acquisition of SheMedia, the recognition of Samantha Skey as its hidden leadership asset, and the founder-led evolution of South by Southwest, Mike Ye explores how disciplined judgment identifies the people, values, and possibilities that numbers alone cannot reveal.",
                "episodeNumber": 3,
                "datePublished": "2026-08-15",
                "inLanguage": "en-US",
